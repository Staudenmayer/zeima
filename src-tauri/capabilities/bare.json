{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bare",
  "description": "The quick switch and prompt windows: only the commands their code can reach, and no plugin access (generated by scripts/tauri-capabilities.mjs).",
  "windows": [
    "quickswitch",
    "prompt"
  ],
  "permissions": [
    "core:default",
    "allow-absence-type-list",
    "allow-activity-create",
    "allow-activity-delete",
    "allow-activity-list",
    "allow-activity-recent",
    "allow-activity-update",
    "allow-addon-suggest",
    "allow-app-info",
    "allow-away-resolve",
    "allow-balance",
    "allow-cost-center-assignment-list",
    "allow-cost-center-delete",
    "allow-cost-center-list",
    "allow-cost-center-save",
    "allow-entry-update",
    "allow-jurisdiction-get",
    "allow-morning-dismiss",
    "allow-profile-list",
    "allow-profile-summary",
    "allow-project-create",
    "allow-project-delete",
    "allow-project-list",
    "allow-project-recent",
    "allow-project-update",
    "allow-prompt-hide",
    "allow-prompt-state",
    "allow-quickswitch-hide",
    "allow-quickswitch-show",
    "allow-schedule-list",
    "allow-settings-get",
    "allow-settings-set",
    "allow-tag-create",
    "allow-tag-delete",
    "allow-tag-list",
    "allow-tag-update",
    "allow-timer-pause",
    "allow-timer-resume",
    "allow-timer-start",
    "allow-timer-state",
    "allow-timer-stop",
    "allow-work-settings-get"
  ]
}
