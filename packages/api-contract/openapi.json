{
  "openapi": "3.1.0",
  "info": {
    "title": "Zeima API",
    "version": "0.1.0",
    "description": "Sync, organizations and licensing for the Zeima desktop app. Errors are `application/problem+json` (RFC 9457) with a stable `code`."
  },
  "components": {
    "securitySchemes": {
      "keycloak": {
        "type": "oauth2",
        "description": "Keycloak access token (`Authorization: Bearer …`)",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8080/realms/zeima/protocol/openid-connect/auth",
            "tokenUrl": "http://localhost:8080/realms/zeima/protocol/openid-connect/token",
            "scopes": {
              "openid": "OpenID Connect"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Always `about:blank`; use `code`."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code, e.g. `unauthorized`."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "message"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "description": "Validation problems (`validation_failed`)."
          }
        },
        "description": "RFC 9457 problem details"
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness: the process is running",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness: the dependencies (Keycloak, later the database) are reachable",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "unavailable"
                          ]
                        }
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "ok"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "error"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "unavailable"
                          ]
                        }
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "ok"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "error"
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "summary": "The signed-in user and their organizations",
        "tags": [
          "me"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "x-org-id",
            "required": false,
            "description": "Active organization; must be one of the user's orgs."
          }
        ],
        "security": [
          {
            "keycloak": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "email",
                    "name",
                    "locale",
                    "roles",
                    "orgs",
                    "activeOrgId"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Keycloak user id"
                    },
                    "email": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "name": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "locale": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Realm roles"
                    },
                    "orgs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "role",
                          "groups"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "role": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "owner"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "admin"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "manager"
                                ]
                              },
                              {
                                "type": "string",
                                "enum": [
                                  "member"
                                ]
                              }
                            ]
                          },
                          "groups": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Department group paths"
                          }
                        }
                      }
                    },
                    "activeOrgId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "From `X-Org-Id`"
                    }
                  },
                  "description": "The signed-in user"
                }
              }
            }
          },
          "401": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Problem details (RFC 9457)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "me",
      "description": "The signed-in user"
    },
    {
      "name": "health",
      "description": "Liveness and readiness"
    }
  ]
}
