# ─────────────────────────────────────────────────────────────────────────────
# Zeima development: the values the helper scripts and the dev stack use.
# Not read by anything on its own: load it into your shell, then run the tools.
#
#   cp deploy/dev.env.example deploy/dev.env
#   set -a; . deploy/dev.env; set +a            # bash/zsh   (fish: see below)
#
# The dev stack itself (Postgres, Keycloak, Mailpit) is deploy/compose.dev.yml:
#   docker compose -f deploy/compose.dev.yml up -d
# fish:  for l in (grep -v '^#' deploy/dev.env | grep .); set -gx (string split -m1 = $l); end
# ─────────────────────────────────────────────────────────────────────────────

# ═══ Containers ═══════════════════════════════════════════════════════════════
# Podman instead of Docker: point compose at its socket
# (systemctl --user start podman.socket) and tell apply.sh which tool to use.
#DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
#CONTAINER=podman                  # docker (default) | podman
# Network apply.sh joins to reach Keycloak by name (default: host).
#CONTAINER_NETWORK=zeima-dev_default

# ═══ Keycloak: applying the realm to a running Keycloak (deploy/keycloak/apply.sh)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=admin
# Placeholders of deploy/keycloak/realm-zeima.json. Use the SAME values as the
# Keycloak container (compose.dev.yml sets these).
ZEIMA_API_ADMIN_SECRET=dev-admin-secret
ZEIMA_API_URL=http://localhost:3000
ZEIMA_WEB_URL=http://localhost:5173
ZEIMA_SWAGGER_ENABLED=true
ZEIMA_SMTP_HOST=mailpit            # Mailpit's inbox: http://localhost:8025
ZEIMA_SMTP_PORT=1025
#ZEIMA_SMTP_FROM=no-reply@zeima.local
#ZEIMA_SMTP_STARTTLS=false
#ZEIMA_SMTP_SSL=false
#ZEIMA_SMTP_AUTH=false
#ZEIMA_SMTP_USER=
#ZEIMA_SMTP_PASSWORD=
# true | false: new people must confirm their address (needs working mail).
ZEIMA_VERIFY_EMAIL=false
# none | external (default) | all: where Keycloak insists on HTTPS.
#ZEIMA_SSL_REQUIRED=external

# ═══ The API for development (also in server/.env.example) ═════════════════
# Start it:  bun run --cwd server dev   (reads server/.env)
# Quickest way without a file:
#   DEFAULT_PLAN=pro KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret bun run --cwd server dev

# ═══ End-to-end checks (deploy/e2e/*.mjs; need Node 24) ══════════════════════
# smoke.mjs: sign-in and sync.  org-smoke.mjs: organizations, shared workspace, approvals.
PUBLIC_URL=http://localhost:3000
ID_URL=http://localhost:8080
KEYCLOAK_ADMIN_PASSWORD=admin
# For a stack with a self-signed certificate (the CI one with Caddy's local CA):
#NODE_TLS_REJECT_UNAUTHORIZED=0

# ═══ The desktop app ═════════════════════════════════════════════════════════
# Run a second, separate instance (own database, backups, addons, device id and
# keychain entries; never stops or is stopped by another one):
#   ZEIMA_DATA_DIR=/tmp/zeima-b ./target/debug/zeima
#ZEIMA_DATA_DIR=/tmp/zeima-b
# Build time (CI sets it as a repository variable): raw Ed25519 public keys,
# comma-separated, of the issuers whose plans a RELEASE build trusts. Debug
# builds also trust the public development key.
#ZEIMA_ENTITLEMENT_KEYS=
# Release signing (CI secrets, see docs/releasing.md): the updater key and its password.
#TAURI_SIGNING_PRIVATE_KEY=
#TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ═══ Tests ═══════════════════════════════════════════════════════════════════
# Postgres for the server tests (they create and drop throw-away databases).
#TEST_DATABASE_URL=postgres://zeima:zeima@localhost:5432/postgres
# Longer sync convergence sweep (default 40 seeds), or one failing seed:
#CONVERGE_SEEDS=600
#CONVERGE_SEED=17
