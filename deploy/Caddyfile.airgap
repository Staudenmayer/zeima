# HTTPS without the internet (docs/airgap.md): Caddy cannot get certificates from Let's Encrypt, so it
# uses a certificate you provide, for DOMAIN and id.DOMAIN (one certificate with both names, or a
# wildcard). Put certs/zeima.crt (with the chain) and certs/zeima.key next to docker-compose.yml.
# Used by deploy/docker-compose.airgap.yml.

{$DOMAIN} {
	tls /certs/zeima.crt /certs/zeima.key
	@metrics path /metrics
	respond @metrics 404
	@internal path /v1/internal /v1/internal/*
	respond @internal 404
	reverse_proxy api:3000
}

id.{$DOMAIN} {
	tls /certs/zeima.crt /certs/zeima.key
	# Only what people's browsers and apps need of the sign-in service: the realm's pages and endpoints and their
	# static files. Keycloak's admin console and the master realm (the bootstrap administrator's login) are NOT
	# published; reach them from inside the network (docs/admin-guide.md, "Keycloak's admin console").
	# Dynamic client registration is not used by the apps; nobody needs to be able to create clients here.
	@noregistration path /realms/zeima/clients-registrations /realms/zeima/clients-registrations/*
	respond @noregistration 404
	@signin path /realms/zeima /realms/zeima/* /resources/* /robots.txt
	handle @signin {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
		}
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
