# ─────────────────────────────────────────────────────────────────────────────
# Zeima, self-hosted: everything deploy/docker-compose.yml reads, with options.
#
#   cp deploy/.env.example deploy/.env      # then fill in the REQUIRED block
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# The stack: caddy (TLS) → api + keycloak → postgres. Sign-in is served at
# ID_URL, the API at PUBLIC_URL.
#
# "#NAME=value" lines are optional: remove the "#" to switch one on.
# Make secrets long and random:  openssl rand -base64 24
# ─────────────────────────────────────────────────────────────────────────────

# ═══ REQUIRED ════════════════════════════════════════════════════════════════
# Host name of this installation (Caddy gets certificates for DOMAIN and id.DOMAIN).
DOMAIN=zeima.example.com
# Full public addresses, with :port if not 443. ID_URL must be what Keycloak
# should call itself: tokens carry it as their issuer.
PUBLIC_URL=https://zeima.example.com
ID_URL=https://id.zeima.example.com

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Password of Keycloak's own admin console user (name: admin).
KEYCLOAK_ADMIN_PASSWORD=
# Secret of the API's Keycloak service account. The API uses it to manage
# organizations; Keycloak gets the same value in its realm. Choose it BEFORE the
# first start: Keycloak reads the realm only once (later: deploy/keycloak/apply.sh).
API_ADMIN_SECRET=

# ═══ Ports ═══════════════════════════════════════════════════════════════════
# Where Caddy listens on the host. Change only if 80/443 are taken (then put the
# port in PUBLIC_URL and ID_URL too, e.g. https://zeima.example.com:8443).
#HTTP_PORT=80
#HTTPS_PORT=443

# ═══ Email (sign-up verification, password reset, ORGANIZATION INVITATIONS) ══
# Keycloak sends the mail. Without a working server, invitations fail.
#SMTP_HOST=localhost
#SMTP_PORT=25                      # 25 plain, 587 STARTTLS, 465 SSL
#SMTP_FROM=no-reply@zeima.example.com
#SMTP_STARTTLS=false               # true for port 587
#SMTP_AUTH=false                   # true if the server wants a login
#SMTP_USER=
#SMTP_PASSWORD=
# Require new people to confirm their address before signing in. Strongly
# advised with real mail: invitations are only applied to verified addresses.
#VERIFY_EMAIL=false

# ═══ API ═════════════════════════════════════════════════════════════════════
# Interactive API docs at PUBLIC_URL/docs: true | false (leave off in production).
#DOCS_ENABLED=false
# Public keys of license issuers, comma-separated (from your license; this is
# how a self-hosted server learns which plans it may trust).
#ENTITLEMENT_PUBLIC_KEYS=
# Secret (16+ characters) for signed calls from a Keycloak event listener to
# POST /v1/internal/keycloak-events (docs/keycloak.md). Empty: endpoint off.
#KEYCLOAK_WEBHOOK_SECRET=
# Hours between the API's checks of its member and department copy against
# Keycloak: 0 (never) to 720.
#RECONCILE_INTERVAL_HOURS=24
