# Copy to deploy/.env and fill in. Used by deploy/docker-compose.yml.

# Host name of this installation; sign-in is served at id.<DOMAIN>.
DOMAIN=zeima.example.com
# Full public addresses of the API and of sign-in (include :port if not 443).
PUBLIC_URL=https://zeima.example.com
ID_URL=https://id.zeima.example.com

# Choose long random values (for example: openssl rand -base64 24).
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
API_ADMIN_SECRET=

# Host ports for Caddy (change only if 80/443 are taken).
#HTTP_PORT=80
#HTTPS_PORT=443

# Email for sign-up verification and password reset.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_FROM=no-reply@zeima.example.com
#SMTP_STARTTLS=true
#SMTP_AUTH=true
#SMTP_USER=
#SMTP_PASSWORD=
#VERIFY_EMAIL=true

# Interactive API docs at PUBLIC_URL/docs (leave off in production).
#DOCS_ENABLED=false
# Public keys of license issuers, comma-separated (from your license).
#ENTITLEMENT_PUBLIC_KEYS=

# Optional. A secret (16+ characters) that signs the calls of a Keycloak event
# listener to the API (see docs/keycloak.md); empty switches the endpoint off.
KEYCLOAK_WEBHOOK_SECRET=
# Hours between the API's checks of its member and department lists against
# Keycloak (0 = never).
RECONCILE_INTERVAL_HOURS=24
