# HTTPS in front of the API and Keycloak (deploy/docker-compose.yml).
# DOMAIN comes from the environment; certificates are automatic.

{$DOMAIN} {
	# Metrics are for the monitoring inside the network (api:3000/metrics), not for the internet.
	@metrics path /metrics
	respond @metrics 404
	# Keycloak's events are for the installation's own network, too (the API also refuses them on this port).
	@internal path /v1/internal /v1/internal/*
	respond @internal 404
	reverse_proxy api:3000
}

id.{$DOMAIN} {
	# Only what people's browsers and apps need of the sign-in service: the realm's pages and endpoints and their
	# static files. Keycloak's admin console and the master realm (the bootstrap administrator's login) are NOT
	# published; reach them from inside the network (docs/admin-guide.md, "Keycloak's admin console").
	@signin path /realms/zeima /realms/zeima/* /resources/* /robots.txt
	handle @signin {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
