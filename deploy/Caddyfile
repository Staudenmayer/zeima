# HTTPS in front of the API and Keycloak (deploy/docker-compose.yml).
# DOMAIN comes from the environment; certificates are automatic.

{$DOMAIN} {
	# Metrics are for the monitoring inside the network (api:3000/metrics), not for the internet.
	@metrics path /metrics
	respond @metrics 404
	reverse_proxy api:3000
}

id.{$DOMAIN} {
	reverse_proxy keycloak:8080
}
