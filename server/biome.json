{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": { "includes": ["src/**", "test/**", "scripts/**", "drizzle.config.ts"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
