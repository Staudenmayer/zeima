# ─────────────────────────────────────────────────────────────────────────────
# Zeima API: every setting, with its options and default.
#
#   cp server/.env.example server/.env          # then edit
#   bun run --cwd server dev                    # reads server/.env
#
# In Docker the same names are set by deploy/docker-compose.yml (from
# deploy/.env, see deploy/.env.example). Empty values count as unset.
# Source of truth: server/src/config.ts. A bad value stops the start-up and
# lists every problem.
#
# Lines starting with "# " are explanations; lines like "#NAME=value" are
# optional settings you can switch on by removing the "#".
# ─────────────────────────────────────────────────────────────────────────────

# ═══ Basics ══════════════════════════════════════════════════════════════════
# development | production | test.  In production there is no built-in
# development signing key, so plans need ENTITLEMENT_SIGNING_KEY or a license.
# WARNING: `development` makes this server trust a PUBLIC license key (anyone can forge a license).
# Only for a server on your own computer. Anything other people reach must say `production`.
NODE_ENV=development
# Where to listen.
HOST=0.0.0.0
PORT=3000
# The address clients use (shown in the API docs, used in links). No trailing slash.
PUBLIC_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true when a reverse proxy (Caddy, an ingress) is in front: trust its
# X-Forwarded-* headers. Leave false when the API is reached directly.
# Behind a reverse proxy: how many are in front (1 for Caddy or one ingress), or their addresses/CIDRs.
# `true` believes any X-Forwarded-For and lets a caller choose their own address: development only.
TRUST_PROXY=false
# self_hosted (default): license files, no billing.
# cloud: billing routes, and plans are enforced on the API (sync needs the
#        `sync` feature, organization routes the `org` feature).
DEPLOYMENT_MODE=self_hosted

# ═══ Database ════════════════════════════════════════════════════════════════
# PostgreSQL 17. The API migrates the schema itself when it starts.
DATABASE_URL=postgres://zeima:zeima@localhost:5432/zeima

# ═══ Keycloak (sign-in) ══════════════════════════════════════════════════════
# The address people sign in at (no /realms/... part). This is also the
# "issuer" of the tokens, so it must be exactly what Keycloak puts in them.
KEYCLOAK_URL=http://localhost:8080
# Where the API itself reaches Keycloak, if that differs, e.g. inside Docker:
#KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=zeima
# `aud` that access tokens must carry.
API_AUDIENCE=zeima-api
# Clients (`azp`) whose tokens are accepted, comma-separated.
ALLOWED_CLIENTS=zeima-desktop
# Public client of the "Authorize" button in /docs.
DOCS_CLIENT_ID=zeima-swagger

# ═══ Organizations (needs the Keycloak admin client) ═════════════════════════
# The service account the API manages users, groups and organizations with.
KEYCLOAK_ADMIN_CLIENT_ID=zeima-api-admin
# Its secret: the value the realm was imported with (ZEIMA_API_ADMIN_SECRET).
# WITHOUT IT every /v1/orgs route answers 503 "organization management is not
# set up". Development stack: dev-admin-secret.
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret
# Optional. Secret (16+ characters) for the signed events of Keycloak's event
# listener, POST /v1/internal/keycloak-events (docs/keycloak.md). Empty: off.
# This value is the one deploy/compose.dev.yml gives the dev Keycloak's listener.
KEYCLOAK_WEBHOOK_SECRET=dev-webhook-secret-12345
# Single sign-on per organization (docs/keycloak.md). An organization points Keycloak at its
# identity provider's address; by default only public https addresses are accepted.
# Development only: lets it be an address on this machine or without https.
#SSO_ALLOW_PRIVATE_URLS=false
# Whether an organization must prove it owns the email domains it signs people in for
# (a TXT record). On by default. Switch it off only for an installation of ONE company whose
# administrators you all trust: otherwise one organization could claim another's domain.
#SSO_VERIFY_DOMAINS=true
# Secret the single sign-on domain proofs are derived from (16+ characters). Default: KEYCLOAK_ADMIN_CLIENT_SECRET.
#SSO_CHALLENGE_SECRET=
# Password for the restricted database login `zeima_app` (16+ letters, digits and _ . ~ -). Set, the API sets that login
# up and serves requests through it instead of stepping down from the owner's connection with SET ROLE.
#APP_DATABASE_PASSWORD=
# A second port for Keycloak's events (/v1/internal/*) and /metrics. Set, those are served there only and are 404 on PORT,
# so a proxy that forwards everything cannot publish them. Keep it off the proxy and off the internet.
#INTERNAL_PORT=3001
# A folder with the addons this server offers (signed packages and index.json, made by
# `node scripts/addons.mjs publish`). Without it the addon registry is empty.
#ADDON_REGISTRY_DIR=
# A folder of extra country profiles (<ID>.toml) the apps download (docs/country-profiles.md).
#JURISDICTIONS_DIR=
# Hours between the API's checks of its member/department copy against
# Keycloak. 0 turns the check off; the maximum is 720.
RECONCILE_INTERVAL_HOURS=24
# On SIGTERM/SIGINT the API first reports itself not ready (/readyz answers 503)
# and, over this many milliseconds, closes the WebSockets (code 1012) at random
# moments so devices do not reconnect all at once; then it stops. Set it below
# the orchestrator's termination grace period. 0 stops at once.
SHUTDOWN_DRAIN_MS=10000
# Most connections of the two database pools: the owner's, and the restricted
# login's (used when APP_DATABASE_PASSWORD is set). Per replica the budget is
# owner pool + tenant pool + 1 bus listen connection + 1 bus notify connection
# (BUS=pg). Keep replicas x that sum below PostgreSQL's max_connections. The
# owner pool needs at least 2.
DB_OWNER_POOL_MAX=10
DB_TENANT_POOL_MAX=10
# How API replicas tell each other about pushes (so devices on another replica
# pull at once) and about stale caches: pg (PostgreSQL LISTEN/NOTIFY, two extra
# connections per replica, on top of the pools above) or memory (one replica
# only). Default: pg. The messages carry opaque ids, never data. Set
# BUS_DATABASE_URL when DATABASE_URL goes through a pooler in transaction mode
# (it cannot LISTEN); default: DATABASE_URL. It must be a direct session
# connection: a transaction-mode pooler silently delivers nothing.
#BUS=pg
#BUS_DATABASE_URL=
# The bus pings itself to notice a silently lost listening connection: ms between
# pings (0 = off) and the longest wait for the echo.
#BUS_PING_INTERVAL_MS=30000
#BUS_PING_TIMEOUT_MS=5000
# After a lost bus connection comes back, devices are told to pull spread over
# 0.5x to 1.5x this many ms (0 = at once), and at most one such round per
# BUS_RESYNC_MIN_INTERVAL_MS.
#BUS_RESYNC_SPREAD_MS=10000
#BUS_RESYNC_MIN_INTERVAL_MS=30000

# ═══ Plans and licenses ══════════════════════════════════════════════════════
# The plan for people without an entitlement: free | pro | team | enterprise.
# Anything but `free` is for development: tokens are signed with the built-in
# (public!) development key. Use DEFAULT_PLAN=pro to try sync without billing.
DEFAULT_PLAN=pro
# Cloud: Ed25519 private key (PKCS#8 DER, base64url) that signs entitlements.
# Create a pair with `node scripts/generate-entitlement-key.mjs`. Keep it in a
# secret store, never in the repository.
#ENTITLEMENT_SIGNING_KEY=
# Self-hosted: raw Ed25519 PUBLIC keys (base64url, comma-separated) whose
# license files this server accepts (PUT /v1/license).
#ENTITLEMENT_PUBLIC_KEYS=
# Oldest desktop app this server works with (major.minor.patch). Older apps
# are asked to update.
MIN_CLIENT_VERSION=0.0.0

# ═══ Billing (cloud only; Lemon Squeezy) ═════════════════════════════════════
# Signing secret of the webhook (>= 8 characters); without it the webhook is off.
#BILLING_WEBHOOK_SECRET=
# Store address used for checkout links, no trailing slash.
#BILLING_STORE_URL=https://zeima.lemonsqueezy.com
# What is for sale, as JSON:
#BILLING_PLANS=[{"key":"pro_monthly","plan":"pro","variantId":"123","checkoutId":"00000000-0000-0000-0000-000000000000"}]

# ═══ Web behaviour ═══════════════════════════════════════════════════════════
# Interactive API docs at /docs. Switch off in production.
DOCS_ENABLED=true
# Prometheus metrics at /metrics.
METRICS_ENABLED=true
# Browser origins allowed by CORS, comma-separated. The desktop app needs none.
#CORS_ORIGINS=https://app.example.com
# Requests per minute per client before the API answers 429.
RATE_LIMIT_PER_MINUTE=300

# ═══ Only for tests (not read by the API) ════════════════════════════════════
# Postgres the server tests create throw-away databases in.
#TEST_DATABASE_URL=postgres://zeima:zeima@localhost:5432/postgres
