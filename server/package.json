{
  "name": "@zeima/server",
  "version": "1.0.0-alpha.5",
  "private": true,
  "description": "Zeima API: sync, organizations and licensing (SPEC §7)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "node scripts/openapi-export.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/under-pressure": "^9.2.1",
    "@fastify/websocket": "^11.3.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.17",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
