{
  "name": "@zeima/server",
  "version": "0.1.0",
  "private": true,
  "description": "Zeima API: sync, organizations and licensing (SPEC §7)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "node scripts/openapi-export.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/under-pressure": "^9.2.1",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jose": "^6.2.12",
    "prom-client": "^15.1.3",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
