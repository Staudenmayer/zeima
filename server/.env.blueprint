# ─────────────────────────────────────────────────────────────────────────────
# Zeima API: every setting, with its options and default.
#
#   cp server/.env.blueprint server/.env        # then edit
#   bun run --cwd server dev                    # reads server/.env
#
# In Docker the same names are set by deploy/docker-compose.yml (from
# deploy/.env, see deploy/.env.blueprint). Empty values count as unset.
# Source of truth: server/src/config.ts. A bad value stops the start-up and
# lists every problem.
#
# Lines starting with "# " are explanations; lines like "#NAME=value" are
# optional settings you can switch on by removing the "#".
# ─────────────────────────────────────────────────────────────────────────────

# ═══ Basics ══════════════════════════════════════════════════════════════════
# development | production | test.  In production there is no built-in
# development signing key, so plans need ENTITLEMENT_SIGNING_KEY or a license.
NODE_ENV=development
# Where to listen.
HOST=0.0.0.0
PORT=3000
# The address clients use (shown in the API docs, used in links). No trailing slash.
PUBLIC_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# true when a reverse proxy (Caddy, an ingress) is in front: trust its
# X-Forwarded-* headers. Leave false when the API is reached directly.
TRUST_PROXY=false
# self_hosted (default): license files, no billing.
# cloud: billing routes, and plans are enforced on the API (sync needs the
#        `sync` feature, organization routes the `org` feature).
DEPLOYMENT_MODE=self_hosted

# ═══ Database ════════════════════════════════════════════════════════════════
# PostgreSQL 17. The API migrates the schema itself when it starts.
DATABASE_URL=postgres://zeima:zeima@localhost:5432/zeima

# ═══ Keycloak (sign-in) ══════════════════════════════════════════════════════
# The address people sign in at (no /realms/... part). This is also the
# "issuer" of the tokens, so it must be exactly what Keycloak puts in them.
KEYCLOAK_URL=http://localhost:8080
# Where the API itself reaches Keycloak, if that differs, e.g. inside Docker:
#KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=zeima
# `aud` that access tokens must carry.
API_AUDIENCE=zeima-api
# Clients (`azp`) whose tokens are accepted, comma-separated.
ALLOWED_CLIENTS=zeima-desktop,zeima-swagger,zeima-web
# Public client of the "Authorize" button in /docs.
DOCS_CLIENT_ID=zeima-swagger

# ═══ Organizations (needs the Keycloak admin client) ═════════════════════════
# The service account the API manages users, groups and organizations with.
KEYCLOAK_ADMIN_CLIENT_ID=zeima-api-admin
# Its secret: the value the realm was imported with (ZEIMA_API_ADMIN_SECRET).
# WITHOUT IT every /v1/orgs route answers 503 "organization management is not
# set up". Development stack: dev-admin-secret.
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-admin-secret
# Optional. Secret (16+ characters) for the signed events of a Keycloak event
# listener, POST /v1/internal/keycloak-events (docs/keycloak.md). Empty: off.
#KEYCLOAK_WEBHOOK_SECRET=
# Hours between the API's checks of its member/department copy against
# Keycloak. 0 turns the check off; the maximum is 720.
RECONCILE_INTERVAL_HOURS=24

# ═══ Plans and licenses ══════════════════════════════════════════════════════
# The plan for people without an entitlement: free | pro | team | enterprise.
# Anything but `free` is for development: tokens are signed with the built-in
# (public!) development key. Use DEFAULT_PLAN=pro to try sync without billing.
DEFAULT_PLAN=pro
# Cloud: Ed25519 private key (PKCS#8 DER, base64url) that signs entitlements.
# Create a pair with `node scripts/generate-entitlement-key.mjs`. Keep it in a
# secret store, never in the repository.
#ENTITLEMENT_SIGNING_KEY=
# Self-hosted: raw Ed25519 PUBLIC keys (base64url, comma-separated) whose
# license files this server accepts (PUT /v1/license).
#ENTITLEMENT_PUBLIC_KEYS=
# Oldest desktop app this server works with (major.minor.patch). Older apps
# are asked to update.
MIN_CLIENT_VERSION=0.0.0

# ═══ Billing (cloud only; Lemon Squeezy) ═════════════════════════════════════
# Signing secret of the webhook (>= 8 characters); without it the webhook is off.
#BILLING_WEBHOOK_SECRET=
# Store address used for checkout links, no trailing slash.
#BILLING_STORE_URL=https://zeima.lemonsqueezy.com
# What is for sale, as JSON:
#BILLING_PLANS=[{"key":"pro_monthly","plan":"pro","variantId":"123","checkoutId":"00000000-0000-0000-0000-000000000000"}]

# ═══ Web behaviour ═══════════════════════════════════════════════════════════
# Interactive API docs at /docs. Switch off in production.
DOCS_ENABLED=true
# Prometheus metrics at /metrics.
METRICS_ENABLED=true
# Browser origins allowed by CORS, comma-separated. The desktop app needs none.
#CORS_ORIGINS=https://app.example.com
# Requests per minute per client before the API answers 429.
RATE_LIMIT_PER_MINUTE=300

# ═══ Only for tests (not read by the API) ════════════════════════════════════
# Postgres the server tests create throw-away databases in.
#TEST_DATABASE_URL=postgres://zeima:zeima@localhost:5432/postgres
